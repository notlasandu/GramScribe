{
  "manifest_version": 3,
  "name": "GramScribe - Instagram Scraper & Reel Transcriber",
  "short_name": "GramScribe",
  "version": "1.3.0",
  "description": "Extract Instagram post details into structured JSON, transcribe Reels audio with AI, and view transcripts interactively in post modals and side panel.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://audio-transcribe.replit.app/*"
  ],
  "action": {
    "default_title": "GramScribe - Open Side Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
